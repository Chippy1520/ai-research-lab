{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Research Lab: Run dashboard",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "streamlit", "run", "app.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Research Lab: Run tests",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Research Lab: Run AdamW reference",
      "type": "process",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["experiments/adamw_reference.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
